if (typeof HI === "undefined") { HI = {}; }

HI.reverseEffects = function (item) {
    var gradientFeather = HI.reverseGradientFeather(item);
    if (!gradientFeather) return null;
    return { gradientFeather: gradientFeather };
};

HI.reverseGradientFeather = function (item) {
    var fill = HI.reverseGradientFeatherFor(item, "fill");
    if (fill) return fill;
    return HI.reverseGradientFeatherFor(item, "item");
};

HI.reverseGradientFeatherFor = function (item, scope) {
    try {
        var settings = scope === "fill"
            ? item.fillTransparencySettings.gradientFeatherSettings
            : item.transparencySettings.gradientFeatherSettings;
        if (!settings || settings.applied !== true) return null;
        var stops = HI.reverseOpacityGradientStops(settings);
        if (!stops.length) return null;
        var out = {
            type: "linear",
            scope: scope,
            angle: HI.numberOrNull(settings.angle) || 0,
            length: HI.numberOrNull(settings.length),
            stops: stops
        };
        var start = HI.reverseGradientStart(settings);
        if (start) out.start = start;
        return out;
    } catch (_) {}
    return null;
};

HI.reverseGradientStart = function (settings) {
    try {
        var value = settings.gradientStart;
        if (!value || value.length < 2) return null;
        return { x: Number(value[0] || 0), y: Number(value[1] || 0) };
    } catch (_) {}
    return null;
};

HI.reverseOpacityGradientStops = function (settings) {
    var out = [], count = HI.reverseGradientStopCount(settings);
    for (var i = 0; i < count; i++) {
        var stop = HI.reverseGradientStopAt(settings, i);
        if (!stop) continue;
        out.push({
            location: Number(stop.location || 0),
            opacity: Number(stop.opacity || 0)
        });
    }
    return out;
};

HI.reverseGradientStopCount = function (settings) {
    try { return settings.opacityGradientStops.count(); } catch (_) {}
    try { return settings.opacityGradientStops.length; } catch (_) {}
    return 0;
};

HI.reverseGradientStopAt = function (settings, index) {
    try { return settings.opacityGradientStops.item(index); } catch (_) {}
    try { return settings.opacityGradientStops[index]; } catch (_) {}
    return null;
};

// Gradient swatches (#9): color fields keep the first stop #hex; gradient facts go to fillGradient / strokeGradient plus a warning.
HI.reverseDomKind = function (value) { try { return String(value.constructor.name || ""); } catch (_) {} return ""; };
HI.reverseIsGradient = function (color) { return HI.reverseDomKind(color) === "Gradient"; };
HI.reverseResolveSwatch = function (color) {
    if (HI.reverseDomKind(color) !== "Swatch") return color;
    try { var resolved = color.getElements()[0]; if (resolved) return resolved; } catch (_) {}
    return color;
};
HI.reverseGradientVisualStyle = function (item) {
    var out = {}, fill = HI.reverseGradientFact(HI.reverseSafeProperty(item, "fillColor"), HI.reverseSafeProperty(item, "gradientFillAngle"));
    var stroke = HI.reverseGradientFact(HI.reverseSafeProperty(item, "strokeColor"), HI.reverseSafeProperty(item, "gradientStrokeAngle"));
    if (fill) out.fillGradient = fill;
    if (stroke) out.strokeGradient = stroke;
    return out;
};
HI.reverseGradientFact = function (color, angle) {
    var gradient = HI.reverseResolveSwatch(color);
    if (!HI.reverseIsGradient(gradient)) return null;
    var type = Number(HI.reverseSafeProperty(gradient, "type"));
    return { type: type === 1918985319 /* GradientType.RADIAL */ ? "radial" : "linear", angle: HI.numberOrNull(angle) || 0, stops: HI.reverseGradientColorStops(gradient) };
};
HI.reverseGradientColorStops = function (gradient) {
    var out = [], stops = HI.reverseSafeProperty(gradient, "gradientStops"), count = 0;
    try { count = Number(stops.length || 0); } catch (_) {}
    for (var i = 0; i < count; i++) {
        var stop = HI.reverseSafeProperty(stops, i);
        if (stop) out.push({ color: HI.reverseColor(HI.reverseSafeProperty(stop, "stopColor")), location: HI.numberOrNull(HI.reverseSafeProperty(stop, "location")) });
    }
    return out;
};
HI.reverseGradientFallbackColor = function (gradient) {
    var stops = HI.reverseGradientColorStops(gradient), color = stops.length ? stops[0].color : null;
    HI.reverseNoteGradient(gradient, color);
    return color;
};
// Switched on/off by HI.exportReverseSnapshot; page item / style walks set the owner; one warning per owner and gradient.
HI.reverseGradientTracking = null;
HI.reverseBeginGradientTracking = function (report) { HI.reverseGradientTracking = { report: report, owner: {}, seen: {} }; };
HI.reverseEndGradientTracking = function () { HI.reverseGradientTracking = null; };
HI.reverseSetGradientOwner = function (owner) { if (HI.reverseGradientTracking) HI.reverseGradientTracking.owner = owner || {}; };
HI.reverseNoteGradient = function (gradient, color) {
    var state = HI.reverseGradientTracking;
    if (!state) return;
    var name = String(HI.reverseSafeProperty(gradient, "name") || ""), owner = state.owner, details = { gradient: name, approximatedColor: color };
    var key = [owner.itemId, owner.styleKind, owner.styleName, name].join("|");
    if (state.seen[key]) return; state.seen[key] = true;
    HI.copyObject(details, owner);
    HI.addMessage(state.report, "warning", "REVERSE_GRADIENT_APPROXIMATED", "Gradient swatch \"" + name + "\" is approximated by its first stop color; HTML keeps a solid color.", details);
};
