if (typeof HI === "undefined") HI = {};

HI.resolveTextFrameOverflow = function (report, frame, item) {
    if (!frame || !item || !item.textFit || !HI.textFrameOverflows(frame)) return false;
    if (item.textFit.mode !== "expand-frame-to-content") return false;

    var original = null;
    try { original = frame.geometricBounds; } catch (_) {}
    if (!original) return false;

    var maxGrowX = Number(item.textFit.maxGrowX || 0);
    var maxGrowY = Number(item.textFit.maxGrowY || 0);
    var tolerance = 0.25;
    if (item.textFit.preferWidth === true && HI.applyTextFitWidthFirst(report, frame, item, original, maxGrowX, tolerance)) {
        return true;
    }
    try {
        frame.fit(FitOptions.FRAME_TO_CONTENT);
    } catch (fitError) {
        HI.addMessage(report, "warning", "TEXT_FIT_UNRESOLVED", "Text frame fit failed", {
            itemId: item.id || null,
            reason: String(fitError)
        });
        return false;
    }

    var fitted = null;
    try { fitted = frame.geometricBounds; } catch (_) {}
    if (!fitted) return false;

    if (item.textFit.preservePosition !== false) {
        fitted = HI.textFitPreservedPositionBounds(original, fitted);
        try { frame.geometricBounds = fitted; } catch (_) {}
    }

    var growX = Math.max(0, HI.boundsWidth(fitted) - HI.boundsWidth(original));
    var growY = Math.max(0, HI.boundsHeight(fitted) - HI.boundsHeight(original));
    if (growX <= maxGrowX + tolerance && growY <= maxGrowY + tolerance && !HI.textFrameOverflows(frame)) {
        HI.addMessage(report, "info", "TEXT_FIT_APPLIED", "Text frame expanded to avoid overset", {
            itemId: item.id || null,
            originalBounds: HI.boundsArray(original),
            fittedBounds: HI.boundsArray(fitted),
            growX: growX,
            growY: growY,
            tolerance: tolerance
        });
        return true;
    }

    try { frame.geometricBounds = original; } catch (_) {}
    if (HI.applyTextFitNudge(report, frame, item, original, maxGrowX, maxGrowY, tolerance)) {
        return true;
    }

    HI.addMessage(report, "warning", "TEXT_FIT_UNRESOLVED", "Text frame cannot be safely expanded within configured limits", {
        itemId: item.id || null,
        originalBounds: HI.boundsArray(original),
        attemptedBounds: HI.boundsArray(fitted),
        growX: growX,
        growY: growY,
        maxGrowX: maxGrowX,
        maxGrowY: maxGrowY
    });
    return false;
};

HI.applyTextFitWidthFirst = function (report, frame, item, original, maxGrowX, tolerance) {
    var limitX = Math.max(0, Number(maxGrowX || 0));
    var step = 0.5;
    var maxSteps = Math.floor((limitX + tolerance + 1e-9) / step);
    if (maxSteps < 1) return false;
    var anchor = String(item.textFit.horizontalAnchor || "start").toLowerCase();
    var hiBounds = HI.textFitWidthBounds(original, maxSteps * step, anchor);
    try { frame.geometricBounds = hiBounds; } catch (_) {}
    if (HI.textFrameOverflows(frame)) {
        try { frame.geometricBounds = original; } catch (_) {}
        return false;
    }
    var lo = 1, hi = maxSteps, bestK = maxSteps, bestBounds = hiBounds, lastK = maxSteps;
    while (lo < hi) {
        var mid = Math.floor((lo + hi) / 2);
        var midBounds = HI.textFitWidthBounds(original, mid * step, anchor);
        lastK = mid;
        try { frame.geometricBounds = midBounds; } catch (_) {}
        if (!HI.textFrameOverflows(frame)) {
            bestK = mid;
            bestBounds = midBounds;
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    if (lastK !== bestK) {
        try { frame.geometricBounds = bestBounds; } catch (_) {}
    }
    HI.addMessage(report, "info", "TEXT_FIT_WIDTH_APPLIED", "Single-line text frame width expanded to avoid overset", {
        itemId: item.id || null,
        originalBounds: HI.boundsArray(original),
        fittedBounds: HI.boundsArray(bestBounds),
        growX: bestK * step,
        growY: 0,
        horizontalAnchor: anchor,
        tolerance: tolerance
    });
    return true;
};

HI.textFitWidthBounds = function (original, growX, anchor) {
    var left = Number(original[1]);
    var right = Number(original[3]);
    if (anchor === "center") {
        left -= growX / 2;
        right += growX / 2;
    } else if (anchor === "end" || anchor === "right") {
        left -= growX;
    } else {
        right += growX;
    }
    return [Number(original[0]), left, Number(original[2]), right];
};

HI.textFitNudgeBounds = function (original, growX, growY) {
    return [Number(original[0]), Number(original[1]), Number(original[2]) + growY, Number(original[3]) + growX];
};

HI.applyTextFitNudge = function (report, frame, item, original, maxGrowX, maxGrowY, tolerance) {
    var limitX = Math.min(Number(maxGrowX || 0), 8);
    var limitY = Math.min(Number(maxGrowY || 0), 8);
    var step = 0.5;
    var maxStepsY = Math.floor((limitY + tolerance + 1e-9) / step);
    var maxStepsX = Math.floor((limitX + tolerance + 1e-9) / step);
    var lastBounds = original;
    var resolved = false;
    var bestX = 0, bestY = 0, bestBounds = original;
    var lastX = -1, lastY = -1;

    function testNudge(kx, ky) {
        var bounds = HI.textFitNudgeBounds(original, kx * step, ky * step);
        lastBounds = bounds;
        lastX = kx;
        lastY = ky;
        try { frame.geometricBounds = bounds; } catch (_) {}
        return !HI.textFrameOverflows(frame);
    }

    if (maxStepsY >= 1) {
        if (testNudge(0, maxStepsY)) {
            var loY = 1, hiY = maxStepsY;
            bestY = maxStepsY;
            bestX = 0;
            bestBounds = lastBounds;
            while (loY < hiY) {
                var midY = Math.floor((loY + hiY) / 2);
                if (testNudge(0, midY)) { bestY = midY; bestBounds = lastBounds; hiY = midY; }
                else { loY = midY + 1; }
            }
            resolved = true;
        } else if (maxStepsX >= 1 && testNudge(maxStepsX, maxStepsY)) {
            var loY2 = 1, hiY2 = maxStepsY;
            bestY = maxStepsY;
            bestX = maxStepsX;
            bestBounds = lastBounds;
            while (loY2 < hiY2) {
                var midY2 = Math.floor((loY2 + hiY2) / 2);
                if (testNudge(maxStepsX, midY2)) { bestY = midY2; bestBounds = lastBounds; hiY2 = midY2; }
                else { loY2 = midY2 + 1; }
            }
            var loX = 1, hiX = maxStepsX;
            while (loX < hiX) {
                var midX = Math.floor((loX + hiX) / 2);
                if (testNudge(midX, bestY)) { bestX = midX; bestBounds = lastBounds; hiX = midX; }
                else { loX = midX + 1; }
            }
            resolved = true;
        }
    }

    if (resolved) {
        if (lastX !== bestX || lastY !== bestY) {
            try { frame.geometricBounds = bestBounds; } catch (_) {}
        }
        HI.addMessage(report, "info", "TEXT_FIT_NUDGE_APPLIED", "Text frame expanded by a small bounded nudge to avoid overset", {
            itemId: item.id || null,
            originalBounds: HI.boundsArray(original),
            fittedBounds: HI.boundsArray(bestBounds),
            growX: bestX * step,
            growY: bestY * step,
            tolerance: tolerance
        });
        return true;
    }

    try { frame.geometricBounds = original; } catch (_) {}
    HI.addMessage(report, "warning", "TEXT_FIT_NUDGE_UNRESOLVED", "Text frame small nudge did not resolve overset", {
        itemId: item.id || null,
        originalBounds: HI.boundsArray(original),
        attemptedBounds: HI.boundsArray(lastBounds),
        maxGrowX: maxGrowX,
        maxGrowY: maxGrowY,
        nudgeLimitX: limitX,
        nudgeLimitY: limitY
    });
    return false;
};

HI.textFitPreservedPositionBounds = function (original, fitted) {
    var height = HI.boundsHeight(fitted);
    var width = HI.boundsWidth(fitted);
    return [
        Number(original[0]),
        Number(original[1]),
        Number(original[0]) + height,
        Number(original[1]) + width
    ];
};

HI.boundsWidth = function (bounds) {
    return Math.max(0, Number(bounds[3]) - Number(bounds[1]));
};

HI.boundsHeight = function (bounds) {
    return Math.max(0, Number(bounds[2]) - Number(bounds[0]));
};

HI.boundsArray = function (bounds) {
    return [Number(bounds[0]), Number(bounds[1]), Number(bounds[2]), Number(bounds[3])];
};

// Read into a variable before negating: ExtendScript lets if (!domObject.prop) errors escape try/catch (#9).
HI.textFrameOverflows = function (frame) { var overflows = frame.overflows; return overflows === true; };
